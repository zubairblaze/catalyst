# Contact form email delivery (server-side, used by /api/contact)
# Copy to .env.local (local) or set in your host's environment (production).
# When these are set, enquiries are emailed to CONTACT_TO. If they are NOT set,
# the form falls back to opening the visitor's email app addressed to CONTACT_TO.

# Where enquiries are sent (defaults to info@thecatalystfze.com)
CONTACT_TO=info@thecatalystfze.com

# SMTP credentials — use the mailbox from your cPanel / email host
SMTP_HOST=mail.thecatalystfze.com
SMTP_PORT=465
SMTP_USER=info@thecatalystfze.com
SMTP_PASS=your-mailbox-password
# Optional friendly From header (must be allowed by your mail server)
SMTP_FROM=The Catalyst Website <info@thecatalystfze.com>
